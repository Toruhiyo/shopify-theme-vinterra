{%- liquid
  comment
    Plain merchant-style promo slideshow. The hero carries zero Bizmis chrome
    on purpose: the demo store has to look like a real storefront so the only
    Bizmis surfaces a lead sees are the orange promo bar and the widget,
    exactly as they would on their own store.
  endcomment

  assign height_class = ''
  if section.settings.height == 'large'
    assign height_class = 'hero--large'
  endif

  assign default_hero_images = 'hero-slide-vineyard.png,hero-slide-red-wine.png,hero-slide-cava.png,hero-slide-white-wine.png,hero-slide-cellar.png,hero-slide-tasting.png'

  assign has_block_images = false
  for block in section.blocks
    if block.settings.image != blank
      assign has_block_images = true
      break
    endif
  endfor

  if has_block_images
    assign slide_count = section.blocks.size
  else
    assign fallback_images = default_hero_images | split: ','
    assign slide_count = fallback_images.size
  endif

  assign interval = section.settings.autoplay_interval | times: 1000

  comment
    The Bizmis demo film plays in the hero (snippets/bizmis-film.liquid), with its own smaller copy inviting the visitor
    to watch it, as in the Meridian demo store. The URL decides in the browser (Liquid can't read the query string):
    ?storehero, ?nofilm and the recording links (?intro=) set html.store-hero (layout/theme.liquid), which shows the
    store's own copy and hides the film.
  endcomment
  assign show_film = false
  if section.settings.film_src != blank
    assign show_film = true
  endif
-%}

<section
  class="hero {{ height_class }}{% if show_film %} hero--has-film{% endif %}"
  data-hero-slideshow
  data-autoplay-interval="{{ interval }}"
  {{ section.shopify_attributes }}
>
  <div class="hero__slides">
    {%- if has_block_images -%}
      {%- for block in section.blocks -%}
        <div
          class="hero__slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="hero__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt="{{ block.settings.image.alt | default: shop.name | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {%- if forloop.first %} fetchpriority="high"{% endif %}
              >
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for img_file in fallback_images -%}
        <div
          class="hero__slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide="{{ forloop.index0 }}"
        >
          <div class="hero__media">
            <img
              src="{{ img_file | strip | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="1536"
              height="1024"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {%- if forloop.first %} fetchpriority="high"{% endif %}
            >
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="page-width hero__container">
    <div class="hero__content">
      <div class="hero__copy hero__copy--store">
      {%- if section.settings.subtitle != blank -%}
        <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="hero__title">
          <span class="hero__title-line">{{ section.settings.title }}</span>
          {%- if section.settings.cta_text != blank -%}
            {%- comment -%}
              The CTA is the title's second line: same scale, brand color,
              underlined, clickable. Starts a voice chat with the clerk.
            {%- endcomment -%}
            <button type="button" class="hero__title-cta" data-open-voice-clerk>
              {{- section.settings.cta_text -}}
            </button>
          {%- endif -%}
        </h1>
      {%- endif -%}
      </div>
      {%- if show_film -%}
        {%- comment -%}
          With the film on: its own copy (locales bizmis.film.*, native in each language), smaller; the heading's second line plays the film,
          in the store's gold underlined call. The play button sits in the middle of the hero (rendered below, as on
          Meridian). The store's own copy above stays in the page for html.store-hero.
        {%- endcomment -%}
        <div class="hero__copy hero__copy--film">
          <p class="hero__subtitle">{{ 'bizmis.film.eyebrow' | t }}</p>
          <h1 class="hero__title">
            <span class="hero__title-line">{{ 'bizmis.film.title' | t }}</span>
            <button type="button" class="hero__title-cta" data-film-open>
              {{- 'bizmis.film.title_cta' | t -}}
            </button>
          </h1>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if show_film -%}
    {%- render 'bizmis-film-button', label: 'bizmis.film.play', length: section.settings.film_length -%}
    {%- render 'bizmis-film',
      src: section.settings.film_src,
      captions: section.settings.film_captions,
      cta_url: section.settings.film_cta_url,
      end_cta: section.settings.film_end_cta,
      end_hold: section.settings.film_end_hold
    -%}
  {%- endif -%}

  {%- if slide_count > 1 -%}
    <div class="hero__nav" aria-label="Slideshow navigation">
      <button class="hero__arrow hero__arrow--prev" data-hero-prev aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <div class="hero__dots">
        {%- for i in (1..slide_count) -%}
          <button
            class="hero__dot{% if forloop.first %} is-active{% endif %}"
            data-hero-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>

      <button class="hero__arrow hero__arrow--next" data-hero-next aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (85vh)" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Auto-rotate interval (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Vins i caves del Penedès des de 1912"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "El sommelier t'espera."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Voice clerk line (second title line)",
      "default": "Digues què vols beure.",
      "info": "Rendered as the highlighted second line of the heading. Opens a voice chat with the store clerk."
    },
    {
      "type": "header",
      "content": "Demo film"
    },
    {
      "type": "text",
      "id": "film_src",
      "label": "Film (HLS .m3u8 or MP4 URL)",
      "default": "https://cdn.bizmis.ai/media/film/demo-viniteca/v5/master.m3u8",
      "info": "Plays over the hero from its play button. Leave empty to hide the film. Its copy, the clerk's invite and the player's words come from the theme's languages (bizmis.film.*)."
    },
    {
      "type": "text",
      "id": "film_length",
      "label": "Film length (shown beside the play button)",
      "default": "3:15"
    },
    {
      "type": "text",
      "id": "film_captions",
      "label": "Captions (.vtt with Narrator and Shopper voices)",
      "default": "https://cdn.bizmis.ai/media/film/demo-viniteca/v5/es.vtt"
    },
    {
      "type": "text",
      "id": "film_cta_url",
      "label": "End button link",
      "default": "https://apps.shopify.com/bizmis"
    },
    {
      "type": "text",
      "id": "film_end_cta",
      "label": "End title box (left,top,width,height as fractions of the frame)",
      "default": "0.1859,0.3972,0.6307,0.1185"
    },
    {
      "type": "text",
      "id": "film_end_hold",
      "label": "Stop this many seconds before the end",
      "default": "1",
      "info": "For a film that fades out: it holds its last clean frame (the closing call to action)."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
