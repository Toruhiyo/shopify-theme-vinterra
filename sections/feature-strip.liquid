<div class="feature-strip">
  <div class="page-width">
    <div class="feature-strip__grid">
      {%- for block in section.blocks -%}
        <div class="feature-strip__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <div class="feature-strip__icon">
              {%- case block.settings.icon -%}
                {%- when 'shipping' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'grape' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V3"/><path d="M12 3c1.5 0 3-.8 4-2"/><circle cx="8" cy="11" r="2.6"/><circle cx="16" cy="11" r="2.6"/><circle cx="12" cy="15" r="2.6"/><circle cx="12" cy="20" r="2.6"/></svg>
                {%- when 'leaf' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {%- when 'award' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.2 14.3 7 22l5-3 5 3-1.2-7.7"/></svg>
                {%- when 'glass' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 22h8"/><path d="M12 15v7"/><path d="M6 3h12l-1 6a5 5 0 0 1-10 0z"/></svg>
                {%- when 'package' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                {%- when 'check' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {%- endcase -%}
            </div>
          {%- endif -%}
          <span class="feature-strip__text">{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature strip",
  "tag": "section",
  "class": "feature-strip-section",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "grape", "label": "Grapes" },
            { "value": "leaf", "label": "Leaf (organic)" },
            { "value": "glass", "label": "Wine glass" },
            { "value": "award", "label": "Award" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "package", "label": "Protected packaging" },
            { "value": "check", "label": "Check" }
          ],
          "default": "grape"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Viticultura ecològica"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Feature strip",
      "blocks": [
        { "type": "feature", "settings": { "icon": "leaf", "text": "Vins ecològics certificats" } },
        { "type": "feature", "settings": { "icon": "grape", "text": "Cellers familiars" } },
        { "type": "feature", "settings": { "icon": "shipping", "text": "Enviament gratuït a partir de 60 €" } },
        { "type": "feature", "settings": { "icon": "package", "text": "Embalatge protegit per a ampolles" } }
      ]
    }
  ]
}
{% endschema %}
