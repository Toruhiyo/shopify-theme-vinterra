{%- comment -%}
  Product Links — Renders sibling bottles as variant-like selectors.
  Each linking metafield group shows as a labelled row of thumbnails or pills:
  formats (75 cl / magnum / doble magnum), vintages, gift packs and pairings.

  Active state: determined by matching display values (not product IDs),
  so the current bottle is always highlighted even after dedup.

  When no linked siblings exist for a dimension but the product carries the
  underlying metafield, a single active pill is rendered (solo fallback).

  Required param: product
{%- endcomment -%}

{%- liquid
  assign LINK_REF_KEYS         = 'format_variants,vintage_variants,pack_variants,range_variants,pairs_with'
  assign LINK_LABEL_KEYS       = 'format,vintage,pack,range,pairs_with'
  assign LINK_IMAGE_KEYS       = 'format_variants,pairs_with'
  assign LINK_VALUE_METAFIELDS = 'bottle_format_cl,vintage,pack_size,range_name,'
  assign LINK_VALUE_SUFFIXES   = ' cl,,,,'
  assign LINK_MAX_ITEMS        = 12
-%}

{%- assign _ref_keys = LINK_REF_KEYS | split: ',' -%}
{%- assign _label_keys = LINK_LABEL_KEYS | split: ',' -%}
{%- assign _val_mfs = LINK_VALUE_METAFIELDS | split: ',' -%}
{%- assign _val_suffixes = LINK_VALUE_SUFFIXES | split: ',' -%}
{%- assign _separator = ' — ' -%}
{%- assign _rendered_keys = '' -%}

{%- for _key in _ref_keys -%}
  {%- assign _idx = forloop.index0 -%}
  {%- assign _label = 'products.links.' | append: _label_keys[_idx] | t -%}
  {%- assign _refs = product.metafields.custom[_key].value -%}
  {%- if _refs == blank or _refs.size == 0 -%}{%- continue -%}{%- endif -%}

  {%- assign _use_image = false -%}
  {%- if LINK_IMAGE_KEYS contains _key -%}
    {%- assign _use_image = true -%}
  {%- endif -%}
  {%- assign _val_mf = _val_mfs[_idx] | strip -%}
  {%- assign _val_suffix = _val_suffixes[_idx] -%}

  {%- comment -%} Display value of the current bottle, used for active-state matching {%- endcomment -%}
  {%- if _val_mf != blank -%}
    {%- assign _current_raw = product.metafields.custom[_val_mf].value -%}
  {%- else -%}
    {%- assign _current_raw = blank -%}
  {%- endif -%}
  {%- if _current_raw != blank -%}
    {%- assign _current_dval = _current_raw | append: _val_suffix -%}
  {%- else -%}
    {%- assign _title_segments = product.title | split: _separator -%}
    {%- assign _current_dval = _title_segments | last -%}
  {%- endif -%}
  {%- assign _current_dedup = _current_dval | strip | downcase -%}

  {%- assign _rendered = 0 -%}
  {%- assign _seen_values = '' -%}
  {%- capture _pills_html -%}
    {%- for _ref in _refs -%}
      {%- if _rendered >= LINK_MAX_ITEMS -%}{%- break -%}{%- endif -%}
      {%- if _ref == blank or _ref.handle == blank -%}{%- continue -%}{%- endif -%}

      {%- if _val_mf != blank -%}
        {%- assign _raw_val = _ref.metafields.custom[_val_mf].value -%}
      {%- else -%}
        {%- assign _raw_val = blank -%}
      {%- endif -%}
      {%- if _raw_val != blank -%}
        {%- assign _display_val = _raw_val | append: _val_suffix -%}
      {%- else -%}
        {%- assign _ref_title_segments = _ref.title | split: _separator -%}
        {%- assign _display_val = _ref_title_segments | last -%}
      {%- endif -%}

      {%- assign _dedup_key = _display_val | strip | downcase -%}
      {%- assign _dedup_token = '||' | append: _dedup_key | append: '||' -%}
      {%- if _seen_values contains _dedup_token -%}{%- continue -%}{%- endif -%}
      {%- assign _seen_values = _seen_values | append: _dedup_token -%}

      {%- assign _is_current = false -%}
      {%- if _dedup_key == _current_dedup -%}{%- assign _is_current = true -%}{%- endif -%}

      <a href="{% if _is_current %}{{ product.url }}{% else %}{{ _ref.url }}{% endif %}"
         class="{% if _use_image %}product-link-swatch{% else %}product-link-pill{% endif %}{% if _is_current %} is-active{% endif %}"
         aria-label="{{ _ref.title }}" title="{% if _is_current %}{{ product.title }}{% else %}{{ _ref.title }}{% endif %}" data-product-link>
        {%- if _use_image -%}
          {%- if _is_current and product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 140 }}" alt="{{ product.title | escape }}" loading="lazy" width="70" height="70">
          {%- elsif _ref.featured_image -%}
            <img src="{{ _ref.featured_image | image_url: width: 140 }}" alt="{{ _ref.title | escape }}" loading="lazy" width="70" height="70">
          {%- endif -%}
          <span class="product-link-swatch__label">{{ _display_val }}</span>
        {%- else -%}
          {{- _display_val -}}
        {%- endif -%}
      </a>
      {%- assign _rendered = _rendered | plus: 1 -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if _rendered > 0 -%}
    {%- assign _rendered_keys = _rendered_keys | append: _key | append: ',' -%}
    <div class="pdp__variants mb-md">
      <p class="pdp__variant-label">{{ _label }}</p>
      <div class="product-link-group" data-product-link-group>{{ _pills_html }}</div>
    </div>
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  Solo fallback — when a bottle has no siblings for a dimension but does carry
  the underlying metafield, still surface it as a single active pill so the
  format and vintage always read the same way across the catalog.
{%- endcomment -%}

{%- unless _rendered_keys contains 'format_variants' -%}
  {%- assign _solo = product.metafields.custom.bottle_format_cl.value -%}
  {%- if _solo != blank -%}
    <div class="pdp__variants mb-md">
      <p class="pdp__variant-label">{{ 'products.links.format' | t }}</p>
      <div class="product-link-group" data-product-link-group>
        <a href="{{ product.url }}" class="product-link-pill is-active" data-product-link>{{ _solo }} cl</a>
      </div>
    </div>
  {%- endif -%}
{%- endunless -%}

{%- unless _rendered_keys contains 'vintage_variants' -%}
  {%- assign _solo = product.metafields.custom.vintage.value -%}
  {%- if _solo != blank -%}
    <div class="pdp__variants mb-md">
      <p class="pdp__variant-label">{{ 'products.links.vintage' | t }}</p>
      <div class="product-link-group" data-product-link-group>
        <a href="{{ product.url }}" class="product-link-pill is-active" data-product-link>{{ _solo }}</a>
      </div>
    </div>
  {%- endif -%}
{%- endunless -%}

{%- unless _rendered_keys contains 'pack_variants' -%}
  {%- assign _solo = product.metafields.custom.pack_size.value -%}
  {%- if _solo != blank -%}
    <div class="pdp__variants mb-md">
      <p class="pdp__variant-label">{{ 'products.links.pack' | t }}</p>
      <div class="product-link-group" data-product-link-group>
        <a href="{{ product.url }}" class="product-link-pill is-active" data-product-link>{{ _solo }}</a>
      </div>
    </div>
  {%- endif -%}
{%- endunless -%}
