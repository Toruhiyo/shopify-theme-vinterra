{%- comment -%}
  Product Specs — renders a wine technical sheet from product metafields.
  Iterates through the curated spec keys in tasting-sheet order, keeping only
  the ones the product actually has a value for. Labels come from the locale
  files (products.specs.*) so the sheet reads in the visitor's language.
  Required param: product
{%- endcomment -%}

{%- liquid
  assign _spec_keys = 'winery,wine_type,do,region,country,vintage,grape_varieties,alcohol_abv,ageing,barrel_months,lees_months,dosage,soil,vine_age_years,altitude_m,yield_hl_ha,harvest,fermentation,malolactic,filtration,natural_wine,organic_certified,biodynamic_certified,vegan,sulfites_mg_l,residual_sugar_gl,total_acidity_gl,ph,production_bottles,winemaker,bottle_format_cl,closure,serving_temperature_c,decanting,cellaring_years,glass_type,awards' | split: ','

  comment
    Unit suffixes appended to raw numeric values, aligned by index with the keys
    above. @months / @years / @bottles are localized at render time.
  endcomment
  assign _spec_suffixes = ',,,,,,, % vol,,@months,@months,,,@years, m, hl/ha,,,,,,,,, mg/l, g/l, g/l,,@bottles,, cl,, °C,,@years,,' | split: ','

  assign _months = 'products.units.months' | t
  assign _years = 'products.units.years' | t
  assign _bottles = 'products.units.bottles' | t
  assign _yes = 'products.yes' | t
  assign _no = 'products.no' | t
-%}

{%- assign _spec_rows = '' -%}

{%- for _key in _spec_keys -%}
  {%- assign _value = product.metafields.custom[_key].value -%}
  {%- if _value == blank -%}{%- continue -%}{%- endif -%}

  {%- assign _label = 'products.specs.' | append: _key | t -%}
  {%- assign _suffix = _spec_suffixes[forloop.index0]
    | replace: '@months', _months
    | replace: '@years', _years
    | replace: '@bottles', _bottles -%}

  {%- if _value == true or _value == 'true' -%}
    {%- assign _display = _yes -%}
  {%- elsif _value == false or _value == 'false' -%}
    {%- assign _display = _no -%}
  {%- else -%}
    {%- comment -%} join flattens list metafields (grape varieties, awards) and leaves single values untouched {%- endcomment -%}
    {%- assign _display = _value | join: ', ' | append: _suffix -%}
  {%- endif -%}

  {%- capture _row -%}
    <tr>
      <td class="specs-table__label">{{ _label }}</td>
      <td class="specs-table__value">{{ _display }}</td>
    </tr>
  {%- endcapture -%}
  {%- assign _spec_rows = _spec_rows | append: _row -%}
{%- endfor -%}

{%- if _spec_rows != blank -%}
  <table class="specs-table">
    <tbody>
      {{ _spec_rows }}
    </tbody>
  </table>
{%- endif -%}
